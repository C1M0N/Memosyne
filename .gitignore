# dotenv secrets (never commit)
.env
.env.local
.env.development
.env.production
.env.test
*.env

# allow example files
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.venv/
.coverage
