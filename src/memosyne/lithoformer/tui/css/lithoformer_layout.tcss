/* Lithoformer TUI - Based on layout.xml (1600×900) - Fixed */

Screen {
    background: #050c15;
    color: #c9d6e8;
    layout: vertical;
}

/* ==================================================================
   MAIN CONTAINER - 左列 + 右侧区域
   ================================================================== */

#main-container {
    layout: horizontal;
    height: 1fr;
}

/* 左列: LOGO + 信息区 + 题目列表 (760px / 1600px ≈ 47.5%) */
#left-col {
    width: 19fr;  /* 760/40 */
    layout: vertical;
}

/* 右侧区域: 中列 + 右列 + 控制台 (840px / 1600px ≈ 52.5%) */
#right-area {
    width: 21fr;  /* 840/40 */
    layout: vertical;
}

/* 顶部区域：中列和右列的水平容器 */
#top-section {
    layout: horizontal;
    height: 24;  /* ~480px - 固定高度以便控制台有空间显示 */
    padding: 0;
}

/* 中列: 配置输入 (560px / 840px ≈ 66.7%) */
#middle-col {
    width: 2fr;  /* 560/280 = 2 */
    layout: vertical;
    padding: 0;
    margin: 0;
}

/* 右列: 文件树 + 按钮 (280px / 840px ≈ 33.3%) */
#right-col {
    width: 1fr;  /* 280/280 = 1 */
    layout: grid;
    grid-size: 1;  /* 1列，行数自动 */
    grid-rows: 1fr auto;  /* 文件树1fr占满，按钮auto自适应 */
    padding: 0;
    margin: 0;
}

/* ==================================================================
   LEFT COLUMN
   ================================================================== */

#logo-panel {
    height: 9;  /* ~180px */
    padding: 1;
    color: #4aa8ff;
    background: #0d141f;
    border: round #1f4b8f;
    text-style: bold;
    margin-bottom: 1;
}

#info-panel {
    height: 3;  /* ~60px - 固定高度 */
    border: round #1f4b8f;
    background: #0d141f;
    padding: 0 1;
    color: #9cb3ce;
    margin-bottom: 1;
}

#questions-table {
    height: 1fr;  /* 自适应高度 */
    min-height: 10;  /* 最小高度 */
    border: round #1f4b8f;
    background: #070d16;
    scrollbar-size-vertical: 1;
}

/* ==================================================================
   MIDDLE COLUMN
   ================================================================== */

#middle-col Input {
    border: round #1f4b8f;
    background: #070d16;
    color: #d7e3f4;
    height: 3;
    padding: 0 1;
    margin-bottom: 0;  /* 减小间距 */
    &:focus {
        border: round #4aa8ff;
    }
}

#middle-col Select {
    border: round #1f4b8f;
    background: #070d16;
    height: 3;
    margin-bottom: 0;  /* 减小间距 */
    &:focus {
        border: round #4aa8ff;
    }
}

/* Select选中值的显示 - 增强对比度 */
#middle-col Select > SelectCurrent {
    color: #ffffff;
    background: #0d1b2e;
    text-style: bold;
}

/* Select下拉箭头 */
#middle-col Select > .select--arrow {
    color: #4aa8ff;
}

/* jira风格的Select */
.jira-selector {
    border: round #2b61a7;
    padding: 0 1;

    &:focus {
        border: round #4aa8ff;
        background: #0d1b2e;
    }
}

/* Select overlay (下拉菜单) */
Select > SelectOverlay {
    background: #0d1b2e;
    border: round #4aa8ff;
}

/* Select 选项列表 */
Select OptionList {
    background: #0d1b2e;
    color: #d7e3f4;
}

/* Select 选中的选项高亮 */
Select OptionList > .option-list--option-highlighted {
    background: #1f4b8f;
    color: #ffffff;
}

/* Select 当前选中的选项 */
Select OptionList > .option-list--option-selected {
    background: #2b61a7;
    color: #ffffff;
    text-style: bold;
}

#provider-model-row {
    layout: horizontal;
    height: 3;
}

#provider-model-row Select {
    width: 1fr;  /* 两个Select平分宽度 */
    margin-bottom: 0;
}

#seq-batch-row {
    layout: horizontal;
    height: 3;
}

#seq-batch-row Input {
    width: 1fr;  /* 两个Input平分宽度 */
    margin-bottom: 0;
}

/* 控制台区域 */
#log-view {
    height: 1fr;  /* 自适应高度 */
    min-height: 10;  /* 最小高度 */
    border: round #1f4b8f;
    background: #070d16;
    scrollbar-size-vertical: 1;
    padding: 1;
    margin-top: 0;
}

#command-input {
    border: round #1f4b8f;
    background: #070d16;
    color: #d7e3f4;
    height: 3;  /* 增加高度，确保能看到输入 */
    padding: 0 1;
    margin-top: 0;
    &:focus {
        border: round #4aa8ff;
    }
}

/* ==================================================================
   RIGHT COLUMN
   ================================================================== */

#file-tree {
    height: 21;
    border: round #1f4b8f;
    background: #070d16;
    scrollbar-size-vertical: 1;
    padding: 1;
    margin: 0;
}

#action-button {
    width: 100%;
    height: 3;
    text-style: bold;
    margin: 0;
}

/* ==================================================================
   BOTTOM SECTION - Custom Progress Bar
   ================================================================== */

#total-progress {
    height: 5;  /* 3行：信息行 + 进度条行 + 百分比行 */
    border: round #1f4b8f;
    background: #0d141f;
    margin: 1 0 0 0;
}

/* ==================================================================
   BUTTON STATES - 重要！
   ================================================================== */

Button.-primary {
    border: wide #2b61a7;  /* 蓝色 - Detect */
    color: #bcd8ff;
    background: #14253a;
    margin: 0;
    content-align: center middle;  /* 文字居中 */
}

Button.-error {
    border: wide #ff4b4b;  /* 红色 - Start */
    color: #ffd8d8;
    background: #3a1c1c;
}

Button.-warning {
    border: wide #f1a208;  /* 黄色 - Running */
    color: #ffe4b2;
    background: #3f2a12;
}

Button:disabled {
    border: wide #29354b;
    color: #5f6f81;
    background: #0d141f;
}

/* ==================================================================
   GENERAL STYLES
   ================================================================== */

Input {
    border-title-color: #69b3ff;
}

Select {
    border-title-color: #69b3ff;
}

Static {
    border-title-color: #69b3ff;
}
